            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/g1_racket_black.stl"/>
            </geometry>
            <material name="g1_racket_black">
                <color rgba="0.025 0.025 0.025 1"/>
            </material>
        </visual>
        <!-- Separate the inserted grip, head and neck instead of using
             a single convex hull that would bridge the socket clearance. -->
        <collision name="right_racket_handle_collision">
            <origin xyz="-0.111 -0.006 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.065 0.026 0.03"/>
            </geometry>
        </collision>
        <collision name="right_racket_head_collision">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/g1_racket_head_collision.stl"/>
            </geometry>
        </collision>
        <collision name="right_racket_neck_collision">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../meshes/g1_racket_neck_collision.stl"/>
            </geometry>
        </collision>
    </link>

    <link name="LL_FOOT">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1e-9"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </link>
    <joint name="LL_FOOT_frame" type="fixed">
        <origin xyz="0.04 0 -0.037" rpy="0 0 0"/>
        <parent link="left_ankle_roll_link"/>
        <child link="LL_FOOT"/>
    </joint>

    <link name="LR_FOOT">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1e-9"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </link>
    <joint name="LR_FOOT_frame" type="fixed">
        <origin xyz="0.04 0 -0.037" rpy="0 0 0"/>
        <parent link="right_ankle_roll_link"/>
        <child link="LR_FOOT"/>
    </joint>
</robot>
