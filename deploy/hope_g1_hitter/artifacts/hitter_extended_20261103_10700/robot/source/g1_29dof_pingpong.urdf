    <!-- The original right-fist keyed insert extends 12.5 mm into the wrist.
         The shoulder is local X=0; the empty handle socket opens toward +X. -->
    <joint name="right_racket_mount_joint" type="fixed">
        <origin xyz="0.0415 -0.003 0" rpy="0 0 0"/>
        <parent link="right_wrist_yaw_link"/>
