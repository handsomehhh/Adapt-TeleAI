<?xml version="1.0"?>

<robot name="g1_29dof_pingpong">

    <!-- G1 with an empty keyed racket-handle mount; no racket is modelled.
         MuJoCo's URDF importer resolves collision meshes through meshdir. -->
    <mujoco>
        <compiler meshdir="../meshes"/>
    </mujoco>

    <link name="pelvis">
        <inertial>
            <origin xyz="0 0 -0.07605" rpy="0 0 0"/>
